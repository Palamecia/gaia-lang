class Parallelogram {

    // Properties of class
    base: Float64;
    height: Float64;

    // Initializer
    pub init(mut self, base: Float64, height: Float64) {
        self.base = base;
        self.height = height;
    }

    pub deinit(self) {}

    // Method to calculate the area of the Parallelogram
    pub fn calculateParallelogramArea(self) -> Float64 {
        return base * height;
    }
}

class Meters {
    value: Float64;

    pub implicit init(mut self, value: Float64) {
        self.value = value;
    }

    pub fn implicit(self) -> Float64 {
        return self.value;
    }
}

virtual class Base {
    virtual fn method(self) {}
}

class Impl : pub Base {
    override fn method(self) {}
}

class List<T> {
    data: [*]T;
    size: Size;
    capacity: Size;

    pub init(self) {}
    pub init(self, move other: Self) {}
    pub init(self, values: []T) {}

    pub fn [](mut self, index: Size) -> &T {}

    pub fn size(self) -> Size {}

    pub fn sort(self) requires Sortable<T> {}
}

class Array<N: Size, T> {
    data: [N]T;
}

